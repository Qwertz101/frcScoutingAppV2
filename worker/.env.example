# Copy to worker/.env. Never commit the filled-in version.
#
# The worker talks to Supabase over plain REST rather than through the app's
# client, which reads import.meta.env and is localStorage-backed.

SUPABASE_URL=
SUPABASE_ANON_KEY=
TBA_API_KEY=

# OCR pool size. Defaults to cores-2, capped at 8, leaving headroom for the
# ffmpeg decode and AnyDesk's screen encoder running on the same machine.
OCR_WORKERS=

# Only needed if ffmpeg is not on PATH and not in winget's install directory.
FFMPEG_PATH=
FFPROBE_PATH=
