{
  "name": "vite-react-typescript-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run tesseract:sync && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:merge": "node scripts/run_merge_tests.mjs",
    "worker:build": "node worker/tools/build.mjs",
    "worker:check": "tsc --noEmit -p worker/tsconfig.worker.json",
    "worker:golden": "node worker/tools/golden-node.mjs",
    "worker": "node worker/src/process.mjs",
    "worker:scan": "node worker/src/scan.mjs",
    "worker:vod": "node worker/tools/make-synthetic-vod.mjs",
    "worker:check-scan": "node worker/tools/check-scan.mjs",
    "worker:main": "node worker/src/main.mjs",
    "worker:dashboard": "node worker/src/dashboard.mjs",
    "worker:check-identify": "node worker/tools/check-identify.mjs",
    "worker:check-thresholds": "node worker/tools/check-thresholds.mjs",
    "worker:live": "node worker/src/live.mjs",
    "worker:check-live-gap": "node worker/tools/check-live-gap.mjs",
    "worker:check-reconnect": "node worker/tools/check-reconnect.mjs",
    "worker:check-live-monitor": "node worker/tools/check-live-monitor.mjs",
    "tesseract:sync": "node scripts/copy-tesseract.mjs",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "postinstall": "npm run tesseract:sync"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "lucide-react": "^0.344.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tesseract.js": "^7.0.0",
    "tesseract.js-core": "^7.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.1",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.18",
    "eslint": "^9.9.1",
    "eslint-plugin-react-hooks": "^5.1.0-rc.0",
    "eslint-plugin-react-refresh": "^0.4.11",
    "gh-pages": "^5.0.0",
    "globals": "^15.9.0",
    "postcss": "^8.4.35",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.3.0",
    "vite": "^5.4.2"
  }
}
