# Tesseract OCR runtime files copied out of node_modules by
# `npm run tesseract:sync` (which `build` and `postinstall` run for you).
# Regenerable, ~12MB, so not tracked. NOTE: eng.traineddata.gz sits in the
# same folder and IS tracked -- it is not on npm and cannot be regenerated.
public/tesseract/worker.min.js
public/tesseract/tesseract-core-*.wasm.js

# Scratch harnesses for diagnosing the CV tracker against real match footage.
# Holds large video files; never commit.
public/_probe/
